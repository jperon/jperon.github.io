{
  "name": "Cantus",
  "short_name": "Cantus",
  "description": "Offline MusicXML sheet music reader",
  "id": "cantus",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2196f3",
  "orientation": "portrait",
  "scope": "./",
  "lang": "en",
  "categories": [
    "music",
    "education",
    "productivity"
  ],
  "protocol_handlers": [
    {
      "protocol": "web+musicxml",
      "url": "./?file=%s"
    },
    {
      "protocol": "web+mxml",
      "url": "./?file=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.recordare.musicxml+xml": [
          ".musicxml",
          ".xml"
        ],
        "application/vnd.recordare.musicxml": [
          ".mxl"
        ],
        "text/xml": [
          ".xml"
        ],
        "application/xml": [
          ".xml"
        ],
        "application/x-musescore": [
          ".mscz",
          ".mscx"
        ],
        "application/octet-stream": [
          ".mscz",
          ".mscx"
        ],
        "text/x-lilypond": [
          ".ly",
          ".lilypond"
        ],
        "text/vnd.abc": [
          ".abc"
        ],
        "text/plain": [
          ".ly",
          ".lilypond",
          ".abc"
        ],
        "audio/midi": [
          ".mid",
          ".midi"
        ],
        "audio/x-midi": [
          ".mid",
          ".midi"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.recordare.musicxml+xml",
            "application/vnd.recordare.musicxml",
            "text/xml",
            "application/xml",
            "application/x-musescore",
            "application/octet-stream",
            "application/zip",
            "audio/x-musescore",
            "text/x-lilypond",
            "text/vnd.abc",
            "text/plain",
            "audio/midi",
            "audio/x-midi",
            ".musicxml",
            ".mxl",
            ".mscz",
            ".mscx",
            ".ly",
            ".lilypond",
            ".abc",
            ".mid",
            ".midi"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/mobile-1.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Main reader view with a MusicXML score"
    },
    {
      "src": "screenshots/mobile-2.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Navigation menu and file selection"
    },
    {
      "src": "screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop interface with multi-page display"
    }
  ]
}
