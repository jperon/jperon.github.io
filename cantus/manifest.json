{
  "name": "Cantus",
  "short_name": "Cantus",
  "description": "Liseuse de partitions MusicXML hors-ligne",
  "id": "cantus",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2196f3",
  "orientation": "portrait",
  "scope": "./",
  "lang": "fr",
  "categories": ["music", "education", "productivity"],
  "protocol_handlers": [
    {
      "protocol": "web+musicxml",
      "url": "./?file=%s"
    },
    {
      "protocol": "web+mxml",
      "url": "./?file=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.recordare.musicxml+xml": [".musicxml", ".xml"],
        "application/vnd.recordare.musicxml": [".mxl"],
        "text/xml": [".xml"],
        "application/xml": [".xml"]
      }
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "url": "file"
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshots/mobile-1.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vue principale de la liseuse avec une partition MusicXML"
    },
    {
      "src": "screenshots/mobile-2.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Menu de navigation et sélection de fichiers"
    },
    {
      "src": "screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Interface desktop avec affichage multi-pages"
    }
  ]
}
